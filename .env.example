# === Supabase ===
NEXT_PUBLIC_SUPABASE_URL=           # https://<project>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=      # Supabase anon/public key (legacy, being phased out)
SUPABASE_SERVICE_ROLE_KEY=          # Supabase service_role key (server-side only)
DATABASE_URL=                       # Direct Postgres connection string
DATABASE_POOLER_URL=                # Supabase pooler connection string (preferred over DATABASE_URL)
SUPABASE_ACCESS_TOKEN=              # Supabase Management API token (for /api/migrate fallback)

# === NextAuth (Google OAuth) ===
NEXTAUTH_URL=                       # https://jan-dashboard.vercel.app (production URL)
NEXTAUTH_SECRET=                    # Random secret for JWT signing (openssl rand -base64 32)
GOOGLE_CLIENT_ID=                   # Google OAuth client ID
GOOGLE_CLIENT_SECRET=               # Google OAuth client secret

# === Security ===
ALLOWED_EMAILS=                     # Comma-separated emails allowed to log in (e.g. jan@example.com)
CRON_SECRET=                        # Bearer token for Vercel Cron (/api/keepalive)

# === Google Drive / Gmail (OAuth scopes: drive.readonly, gmail.readonly) ===
GOOGLE_DRIVE_BACKLOG_FOLDER_ID=     # Google Drive folder ID for audio backlog

# === AI APIs ===
ANTHROPIC_API_KEY=                  # Anthropic API key (finance categorization, backlog classification)
OPENAI_API_KEY=                     # OpenAI API key (Whisper transcription)

# === Garmin Connect ===
GARMIN_EMAIL=                       # Garmin account email
GARMIN_PASSWORD=                    # Garmin account password
GARMIN_TOKEN=                       # Base64-encoded Garmin OAuth token (from /garmin-auth MFA flow)

# === Vercel (auto-set, do not configure manually) ===
# VERCEL_URL=                       # Set automatically by Vercel
# VERCEL_PROJECT_PRODUCTION_URL=    # Set automatically by Vercel
# VERCEL_ENV=                       # Set automatically by Vercel
